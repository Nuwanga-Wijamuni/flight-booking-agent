FLIGHT_PROVIDER=demo
# Set FLIGHT_PROVIDER=duffel_test for sandbox searches; live tokens are rejected.
DUFFEL_ACCESS_TOKEN=
# Leave empty for the offline demo parser. Never put this key in frontend code.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
DATABASE_URL=sqlite:///./flight_agent.db
# Optional PostgreSQL: postgresql+psycopg://flight:flight@localhost:5432/flight
CORS_ORIGIN=http://localhost:5173
